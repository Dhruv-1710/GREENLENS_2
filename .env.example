# GreenLens environment variables — copy to .env and fill in what you have.
# EVERYTHING here is OPTIONAL for a localhost run: the app starts and the
# dashboard works without any keys, using OSM data and built-in fallbacks.

# OpenWeatherMap API key — live temperature/humidity/wind + city search
# https://openweathermap.org/api
WEATHER_KEY=

# WAQI token — live air quality (AQI), local station data, 7-day PM2.5 trend
# https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Flask session secret — any random string; auto-generated if left empty
SECRET_KEY=

# --- Google Earth Engine (satellite tiles: NDVI, thermal, plantation) ---
# On localhost the easiest path is:  pip install earthengine-api  then
# run `earthengine authenticate` once — no key file needed.
# For server deployments, point GEE_KEY_FILE at a service-account JSON key.
GEE_PROJECT=
GEE_EMAIL=
GEE_KEY_FILE=

# Overpass (OSM) request timeout in seconds. Default 25 — good for localhost.
# Hosted deployments with a 30s request limit (Render/gunicorn) should use 8.
OVERPASS_TIMEOUT=

# Port for `python app.py` (defaults to 5000)
PORT=5000
